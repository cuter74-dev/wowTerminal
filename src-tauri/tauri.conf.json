{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wowTerminal",
  "version": "0.13.9",
  "identifier": "com.wowterminal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wowTerminal",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/cuter74-dev/wowTerminal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDNTM2MjNGMzNENzkzNDcKUldSSGs5Y3pQMkpUWEVPWXA5Vno4cGg1ZVhBaTJoUnZQbXdGSXhxZ0JYalplUFpPRVhUR1NJbHIK"
    }
  }
}
